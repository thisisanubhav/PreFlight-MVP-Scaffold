# Comma-separated list is not used — cors_origins has a code default of
# http://localhost:3000. Override only if your frontend runs elsewhere.
# CORS_ORIGINS=["http://localhost:3000"]

# Required from Phase 3 onward (Gemini vision for keyframes, Gemini text for
# causal explanation / hook rewrite synthesis). Not needed for Phase 1-2.
GEMINI_API_KEY=

# Phase 6: set to true to always serve the cached demo result.
DEMO_MODE=false
